{
	"schema_version": "3.0.0",
	"suite": "hddagi_screen_probe_phase3_spatial_restir_smoke",
	"acceptance_ready": true,
	"scope": "Portable structural smoke for the isolated Forward+ Vulkan Phase 3 route. It validates routing, temporal on/off configurations, counters, finite execution, CPU contract, and the NRD guide/final path; it is not a calibrated radiometric, variance, performance, or memory profile.",
	"minimum_counter_snapshots_per_sample_segment": 4,
	"minimum_gpu_profile_blocks": 1,
	"required_runner_checks": [
		"all_required_project_settings_exist",
		"both_configurations_executed",
		"all_configuration_states_valid",
		"temporal_on_and_off_covered",
		"all_outputs_non_black_and_finite"
	],
	"required_sample_segments": [
		{
			"label": "temporal_off",
			"segment": "phase3_spatial/temporal_off_sample",
			"temporal": false,
			"feature_flags": 65
		},
		{
			"label": "temporal_on",
			"segment": "phase3_spatial/temporal_on_sample",
			"temporal": true,
			"feature_flags": 67
		}
	],
	"required_gpu_task_markers": [
		"HDDAGI Screen Probe Surface Select",
