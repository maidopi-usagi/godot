; Engine configuration file.
; This is a standalone manual QA project. Run it with the current editor binary.

config_version=5

[application]

config/name="HDDAGI Screen Probe Phase 0, Phase 1, and Phase 2 QA"
run/main_scene="res://qa_runner.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/use_taa=false
environment/defaults/default_clear_color=Color(0.015, 0.018, 0.024, 1)
global_illumination/hddagi/screen_probe_debug_counters=true
global_illumination/hddagi/screen_probe_restir_base_candidate_count=1
global_illumination/hddagi/screen_probe_restir_spatial_guiding=false
global_illumination/hddagi/screen_probe_restir_temporal_guiding=false
